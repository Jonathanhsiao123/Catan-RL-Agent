# Copy to .env (gitignored) and fill in. Read by catan_rl/llm_negotiator.py.
# Variables already set in the shell take precedence over this file.

# Luminal Cloud (OpenAI-compatible chat completions)
LUMINAL_API_KEY=
LUMINAL_BASE_URL=
LUMINAL_MODEL=

# Seconds to wait on a remote LLM call before falling back to structured text
CATAN_LLM_TIMEOUT=15
